{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controlled Writer Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "adapterId",
    "displayName",
    "implementation",
    "enabled",
    "environments",
    "manifestSchema",
    "receiptSchema",
    "methods",
    "controls"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "adapterId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "displayName": { "type": "string", "minLength": 3 },
    "implementation": {
      "type": "string",
      "pattern": "^(?:not-configured|[A-Za-z0-9._/-]+)$"
    },
    "enabled": { "type": "boolean" },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["local", "test", "staging", "production"] }
    },
    "manifestSchema": {
      "const": "schemas/workbook-write-manifest.schema.json"
    },
    "receiptSchema": {
      "const": "schemas/workbook-write-receipt.schema.json"
    },
    "methods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "apply", "readBack", "replay", "rollback"],
      "properties": {
        "plan": { "const": "plan" },
        "apply": { "const": "apply" },
        "readBack": { "const": "readBack" },
        "replay": { "const": "replay" },
        "rollback": { "const": "rollback" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dryRunDefault",
        "exactPlanHashRequired",
        "preconditionsRequired",
        "boundedScopeRequired",
        "completeReadBackRequired",
        "secondReadPathRequired",
        "replayMustWriteZero",
        "rollbackRequired",
        "secretValuesForbidden"
      ],
      "properties": {
        "dryRunDefault": { "const": true },
        "exactPlanHashRequired": { "const": true },
        "preconditionsRequired": { "const": true },
        "boundedScopeRequired": { "const": true },
        "completeReadBackRequired": { "const": true },
        "secondReadPathRequired": { "const": true },
        "replayMustWriteZero": { "const": true },
        "rollbackRequired": { "const": true },
        "secretValuesForbidden": { "const": true }
      }
    }
  }
}
