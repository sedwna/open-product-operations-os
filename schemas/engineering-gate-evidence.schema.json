{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Quality Gate Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gateId", "planId", "implementationRevision", "relevantWorkstreamIds", "workstreamRuns", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "gateId": { "type": "string", "pattern": "^GATE-[A-Z0-9-]+$" },
    "planId": { "type": "string", "pattern": "^ENGPLAN-[A-Za-z0-9._-]+$" },
    "implementationRevision": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
    "relevantWorkstreamIds": { "$ref": "#/$defs/nonEmptyStrings" },
    "workstreamRuns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workstreamId", "ownerRole", "status", "verificationDisposition", "commands", "evidence", "knownRisks"],
        "properties": {
          "workstreamId": { "type": "string", "pattern": "^WS-[0-9]{2}$" },
          "ownerRole": { "type": "string", "pattern": "^ENG-[0-9]{2}$" },
          "status": { "enum": ["completed", "blocked", "failed"] },
          "verificationDisposition": { "enum": ["passed", "failed", "blocked", "not_applicable"] },
          "commands": { "$ref": "#/$defs/strings" },
          "evidence": { "$ref": "#/$defs/strings" },
          "knownRisks": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
