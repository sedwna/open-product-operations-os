{
  "name": "open-product-operations-os",
  "version": "0.8.1",
  "description": "Vendor-neutral Product and Development Operations OS with governed contract synchronization",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sedwna/open-product-operations-os.git"
  },
  "homepage": "https://github.com/sedwna/open-product-operations-os#readme",
  "bugs": {
    "url": "https://github.com/sedwna/open-product-operations-os/issues"
  },
  "author": "Open Product Operations OS contributors",
  "funding": false,
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "type": "module",
  "bin": {
    "development-os": "./src/development-cli.js",
    "product-ops": "./src/cli.js",
    "product-ops-mcp": "./src/mcp/server.js"
  },
  "files": [
    "src",
    "schemas",
    "templates",
    "examples",
    "docs",
    "scripts",
    "tests",
    ".gitattributes",
    "npm-shrinkwrap.json",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "START-HERE.md"
  ],
  "scripts": {
    "docs:diagrams": "node scripts/render-readme-diagrams.mjs",
    "prepack": "node scripts/pack-lifecycle.mjs prepare",
    "postpack": "node scripts/pack-lifecycle.mjs restore",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "check": "npm run lint && npm run clean-room:check && npm test && npm run portability",
    "smoke": "node scripts/smoke.mjs",
    "portability": "node scripts/verify-portability.mjs",
    "clean-room:check": "node scripts/check-clean-room.mjs",
    "clean-archive:check": "node scripts/check-clean-archive-pack.mjs",
    "clean-clone:check": "node scripts/check-clean-clone-pack.mjs",
    "cross-host:check": "node scripts/check-cross-host-pack.mjs",
    "sbom:check": "node scripts/check-sbom.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "packed:check": "node scripts/check-packed-artifact.mjs",
    "supply-chain": "npm audit --omit=dev --audit-level=high && npm run clean-room:check && npm run licenses:check && npm run sbom:check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "vazirmatn": "33.0.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5"
  }
}
